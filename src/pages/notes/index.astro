---
import IndexLayout from '@/layouts/IndexLayout.astro'
import PostCard from '@/components/widgets/PostCard.astro'
import { themeConfig } from '@/config'
import { getSortedFilteredPosts } from '@/utils/draft'

const allPosts = await getSortedFilteredPosts()
const posts = allPosts.filter((p) => p.data.category === '学习笔记')
---

<IndexLayout title={`学习笔记 - ${themeConfig.site.title}`} description="学习笔记专栏：记录学习路上的点滴、踩过的坑和总结">
  <header class="page-header stack">
    <h1 class="page-title">学习笔记</h1>
    <p class="page-desc">工具怎么装怎么用、概念怎么理解、遇到坑怎么绕过去。内容比较碎，但都是实际操作过的。</p>
  </header>
  {
    posts.length > 0 ? (
      <section class="panel">
        <div class="panel-list">
          {posts.map((post) => (
            <PostCard post={post} variant="list" thumb />
          ))}
        </div>
      </section>
    ) : (
      <p class="page-empty">学习笔记栏目暂无内容。</p>
    )
  }
</IndexLayout>

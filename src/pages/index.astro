---
import IndexLayout from '@/layouts/IndexLayout.astro'
import PostCard from '@/components/widgets/PostCard.astro'
import { themeConfig } from '@/config'
import { projects } from '@/data/projects'
import { getPostStream } from '@/utils/draft'

const stream = await getPostStream()
const latestPosts = stream.slice(0, 5)
const homeProjects = projects.slice(0, 4)
---

<IndexLayout title={themeConfig.site.title} description={themeConfig.site.description}>
  <div class="home-grid">
    <!-- 左栏：头像 / 简介 / 站点链接 / 技术栈 -->
    <aside class="profile">
      <img class="profile-avatar" src="/images/avatar.png" alt={themeConfig.site.author} width="112" height="112" />
      <h1 class="profile-name">{themeConfig.site.title}</h1>
      {themeConfig.site.tagline && <p class="profile-bio">{themeConfig.site.tagline}</p>}

      <div class="profile-links">
        {
          themeConfig.site.github && (
            <a class="link-pill" href={themeConfig.site.github} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.15c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.24 3.33.95.1-.74.4-1.24.72-1.53-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 2.87-.39c.97 0 1.96.13 2.87.39 2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.73.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.41-5.25 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
              </svg>
              GitHub
            </a>
          )
        }
        {
          themeConfig.site.leetcode && (
            <a class="link-pill" href={themeConfig.site.leetcode} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m8 8-4 4 4 4" />
                <path d="m16 8 4 4-4 4" />
                <path d="M13.5 5 10.5 19" />
              </svg>
              LeetCode
            </a>
          )
        }
      </div>

      {
        themeConfig.techStack && themeConfig.techStack.length > 0 && (
          <div class="profile-tech">
            <h2 class="side-title">技术栈</h2>
            <ul class="tech-chips">
              {themeConfig.techStack.map((tech) => (
                <li class="tech-chip">{tech}</li>
              ))}
            </ul>
          </div>
        )
      }
    </aside>

    <!-- 右栏：最新文章 + 项目列表 -->
    <div class="home-main">
      <section class="panel latest-panel">
        <div class="panel-head">
          <h2 class="section-title">最新文章</h2>
          <a class="section-more" href="/archive/">查看全部 →</a>
        </div>
        {
          latestPosts.length > 0 ? (
            <div class="latest-list">
              {latestPosts.map((post) => (
                <PostCard post={post} variant="list" thumb />
              ))}
            </div>
          ) : (
            <p class="page-empty">还没有文章，去 <a href="/archive/">归档页</a> 看看。</p>
          )
        }
      </section>

      <section class="panel projects-panel">
        <div class="panel-head">
          <h2 class="section-title">项目列表</h2>
          <a class="section-more" href="/projects/">查看全部 →</a>
        </div>
        <ul class="project-list">
          {
            homeProjects.map((project) => (
              <li>
                <a class="project-item" href={project.href}>
                  <span class="project-name">{project.name}</span>
                  <span class="project-desc">{project.description}</span>
                  <span class="project-tech">
                    {project.tech.map((tech) => (
                      <span class="tech-pill">{tech}</span>
                    ))}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
</IndexLayout>

<style>
  /* ========== 两栏布局 ========== */
  .home-grid {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: 2.5rem;
    align-items: start;
  }

  /* ========== 左栏：个人资料 ========== */
  .profile {
    position: sticky;
    top: 4.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .profile-avatar {
    width: 7rem;
    height: 7rem;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--sheet);
    box-shadow: 0 6px 22px rgba(0, 0, 0, 0.1);
  }
  .profile-name {
    margin: 1rem 0 0;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .profile-bio {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--text-tertiary);
  }
  .profile-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .link-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--sheet);
    font-size: 0.78rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition:
      color 0.15s ease-out,
      border-color 0.15s ease-out;
  }
  .link-pill:hover {
    color: var(--text-primary);
    border-color: var(--text-tertiary);
  }
  .profile-tech {
    margin-top: 1.5rem;
  }
  .side-title {
    margin: 0 0 0.6rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }
  .tech-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tech-chip {
    padding: 0.22rem 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--surface-muted);
    border: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 0.72rem;
    line-height: 1.6;
    white-space: nowrap;
  }

  /* ========== 右栏：卡片面板 ========== */
  .home-main {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    min-width: 0;
  }
  .projects-panel {
    padding-bottom: 0.9rem;
  }
  .latest-list {
    margin-top: 0.25rem;
  }

  /* ========== 响应式 ========== */
  @media (max-width: 860px) {
    .home-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }
    .profile {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 0 1rem;
    }
    .profile-avatar {
      width: 4.5rem;
      height: 4.5rem;
    }
    .profile-name {
      margin-top: 0;
      font-size: 1.125rem;
    }
    .profile-bio {
      flex-basis: 100%;
    }
    .profile-links {
      margin-top: 1rem;
    }
    .profile-tech {
      flex-basis: 100%;
      margin-top: 1.25rem;
    }
  }

  @media (max-width: 640px) {
    .home-main {
      gap: 1.5rem;
    }
    .project-item {
      margin: 0 -0.6rem;
      padding: 0.85rem 0.6rem;
    }
  }
</style>

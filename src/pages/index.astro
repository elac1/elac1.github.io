---
import IndexLayout from '@/layouts/IndexLayout.astro'
import PostCard from '@/components/widgets/PostCard.astro'
import FeaturedCard from '@/components/widgets/FeaturedCard.astro'
import Pagination from '@/components/widgets/Pagination.astro'
import { themeConfig } from '@/config'
import { getFeaturedAndStream, POST_PAGE_SIZE } from '@/utils/draft'

const { featured, stream } = await getFeaturedAndStream()

const firstPagePosts = stream.slice(0, POST_PAGE_SIZE)
const totalPages = Math.max(1, Math.ceil(stream.length / POST_PAGE_SIZE))
---

<IndexLayout title={themeConfig.site.title} description={themeConfig.site.description}>
  <div class="blog-home">
    <section class="hero-block">
      <h1 class="hero-title">{themeConfig.site.title}</h1>
      <p class="hero-desc">{themeConfig.site.description}</p>
    </section>

    {
      featured.length > 0 && (
        <section class="home-section">
          <div class="featured-list">
            {featured.map((post) => <FeaturedCard post={post} />)}
          </div>
        </section>
      )
    }

    <section class="home-section">
      <h2 class="section-label">最新文章</h2>
      <div class="posts-list">
        {firstPagePosts.map((post) => <PostCard post={post} />)}
      </div>
      {stream.length === 0 && (
        <p class="empty-state">近一周还没有新文章，去<a href="/archive/">归档页</a>翻翻旧文吧。</p>
      )}
    </section>

    <Pagination current={1} total={totalPages} />
  </div>
</IndexLayout>

<style is:global>
  body:has(.blog-home) {
    max-width: none !important;
    padding: 1.5rem !important;
  }
</style>

<style>
  .blog-home {
    max-width: 44rem;
    margin: 0 auto;
    padding: 0 0 4rem;
  }

  /* Hero —— 克制的开场 */
  .hero-block {
    padding: 3.5rem 0 2.5rem;
    border-bottom: 1px solid var(--border);
  }
  .hero-title {
    margin: 0;
    font-size: 1.625rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  .hero-desc {
    margin: 0.55rem 0 0;
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* 区块 */
  .home-section {
    padding: 2.5rem 0 0;
  }
  .home-section + .home-section {
    padding-top: 2.75rem;
  }

  .section-label {
    margin: 0 0 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .featured-list {
    display: flex;
    flex-direction: column;
  }
  .featured-list > :not(:last-child) {
    border-bottom: 1px solid var(--border);
  }

  .posts-list {
    display: flex;
    flex-direction: column;
  }

  .empty-state {
    color: var(--text-secondary);
    font-size: 0.875rem;
    padding: 2rem 0;
    line-height: 1.7;
  }
  .empty-state a {
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--text-tertiary);
    text-underline-offset: 3px;
  }

  @media (max-width: 640px) {
    .blog-home {
      padding-bottom: 3rem;
    }
    .hero-block {
      padding: 2rem 0 1.75rem;
    }
    .hero-title {
      font-size: 1.375rem;
    }
    .home-section {
      padding-top: 2rem;
    }
  }
</style>

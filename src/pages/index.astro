---
import IndexLayout from '@/layouts/IndexLayout.astro'
import HomePostCard from '@/components/stellar/HomePostCard.astro'
import Icon from '@/components/stellar/Icon.astro'
import { themeConfig } from '@/config'
import { getPostStream } from '@/utils/draft'
import '@/styles/home.css'

const stream = await getPostStream()
const now = Date.now()
const cutoff = now - 30 * 24 * 60 * 60 * 1000
const latestIds = new Set(
  stream
    .filter((post) => post.data.pubDate.valueOf() >= cutoff && post.data.pubDate.valueOf() <= now)
    .map((post) => post.id)
)
const topics = [
  { id: 'latest', name: '近一个月' },
  { id: 'ros', name: 'ROS 2' },
  { id: 'vision', name: '机器视觉' },
  { id: 'simulation', name: '仿真' }
]
---

<IndexLayout title={themeConfig.site.title} description={themeConfig.site.description}>
  <div class="home-library" data-home-library>
    <header class="home-intro">
      <div>
        <h1>
          学习<span class="home-intro-join">与</span>实践<span class="home-intro-period" aria-hidden="true">.</span>
        </h1>
        <p>记录机器人、机器视觉与开发中的问题和尝试。</p>
      </div>
      <a class="home-text-link" href="/about/">关于这个空间<Icon name="arrow" size={14} /></a>
    </header>
    <section aria-labelledby="home-posts-title">
      <div class="home-section-heading">
        <div>
          <h2 id="home-posts-title" data-home-title>近一个月的文章</h2>
          <span class="home-count" data-home-count aria-live="polite">{latestIds.size} 篇</span>
        </div>
        <a class="home-text-link" href="/archive/">全部 {stream.length} 篇<Icon name="arrow" size={14} /></a>
      </div>
      <div class="home-topics" role="group" aria-label="按主题筛选文章">
        {
          topics.map((topic) => (
            <button type="button" data-home-topic={topic.id} aria-pressed={topic.id === 'latest' ? 'true' : 'false'}>
              {topic.name}
            </button>
          ))
        }
      </div>
      <div class="home-post-grid">
        {stream.map((post, index) => <HomePostCard post={post} latest={latestIds.has(post.id)} eager={index < 4} />)}
      </div>
      <p class="home-empty" data-home-empty hidden={latestIds.size > 0}>近一个月暂无文章，可以查看全部文章。</p>
    </section>
  </div>
</IndexLayout>

<script>
  function initHomeLibrary() {
    const home = document.querySelector<HTMLElement>('[data-home-library]')
    if (!home || home.dataset.bound) return
    home.dataset.bound = 'true'
    const buttons = home.querySelectorAll<HTMLButtonElement>('[data-home-topic]')
    const posts = home.querySelectorAll<HTMLElement>('[data-home-post]')
    const title = home.querySelector<HTMLElement>('[data-home-title]')!
    const count = home.querySelector<HTMLElement>('[data-home-count]')!
    const empty = home.querySelector<HTMLElement>('[data-home-empty]')!
    const now = Date.now()
    const cutoff = now - 30 * 24 * 60 * 60 * 1000
    posts.forEach((post) => {
      const published = Number(post.dataset.published)
      post.dataset.latest = String(published >= cutoff && published <= now)
    })
    const names: Record<string, string> = {
      latest: '近一个月的文章',
      ros: 'ROS 2',
      vision: '机器视觉',
      simulation: '仿真'
    }
    function selectTopic(topic: string) {
      let visibleCount = 0
      posts.forEach((post) => {
        const visible =
          post.dataset.latest === 'true' && (topic === 'latest' || !!post.dataset.topics?.split(' ').includes(topic))
        post.hidden = !visible
        if (visible) visibleCount++
      })
      buttons.forEach((item) => item.setAttribute('aria-pressed', String(item.dataset.homeTopic === topic)))
      title.textContent = names[topic]
      count.textContent = `${visibleCount} 篇`
      empty.textContent = topic === 'latest' ? '近一个月暂无文章，可以查看全部文章。' : '近一个月这个主题暂无文章。'
      empty.hidden = visibleCount > 0
    }
    buttons.forEach((button) => button.addEventListener('click', () => selectTopic(button.dataset.homeTopic!)))
    selectTopic('latest')
  }
  document.addEventListener('astro:page-load', initHomeLibrary)
</script>

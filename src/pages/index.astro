---
import IndexLayout from '@/layouts/IndexLayout.astro'
import PostMonthList from '@/components/widgets/PostMonthList.astro'
import Pagination from '@/components/widgets/Pagination.astro'
import { themeConfig } from '@/config'
import { getPostStream, POST_PAGE_SIZE } from '@/utils/draft'

const stream = await getPostStream()

const firstPagePosts = stream.slice(0, POST_PAGE_SIZE)
const totalPages = Math.max(1, Math.ceil(stream.length / POST_PAGE_SIZE))
---

<IndexLayout title={themeConfig.site.title} description={themeConfig.site.description}>
  <div class="blog-home">
    <section class="hero-block">
      <h1 class="hero-title">{themeConfig.site.title}</h1>
      <p class="hero-desc">{themeConfig.site.description}</p>
    </section>

    <section class="home-section">
      {
        firstPagePosts.length > 0 ? (
          <PostMonthList posts={firstPagePosts} />
        ) : (
          <p class="empty-state">
            还没有文章，去<a href="/archive/">归档页</a>看看，或在 <code>src/content/posts</code> 里写一篇。
          </p>
        )
      }
    </section>

    <Pagination current={1} total={totalPages} />
  </div>
</IndexLayout>

<style is:global>
  body:has(.blog-home) {
    max-width: none !important;
    padding: 1.5rem !important;
  }
</style>

<style>
  .blog-home {
    max-width: 44rem;
    margin: 0 auto;
    padding: 0 0 4rem;
  }

  /* Hero —— 克制的开场 */
  .hero-block {
    padding: 3.5rem 0 2.5rem;
  }
  .hero-title {
    margin: 0;
    font-size: 1.625rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  .hero-desc {
    margin: 0.55rem 0 0;
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .home-section {
    padding: 1rem 0 0;
  }

  .empty-state {
    color: var(--text-secondary);
    font-size: 0.875rem;
    padding: 2rem 0;
    line-height: 1.7;
  }
  .empty-state a {
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--text-tertiary);
    text-underline-offset: 3px;
  }
  .empty-state code {
    background: var(--code-bg);
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    font-size: 0.85em;
    font-family: var(--mono);
  }

  @media (max-width: 640px) {
    .blog-home {
      padding-bottom: 3rem;
    }
    .hero-block {
      padding: 2rem 0 1.5rem;
    }
    .hero-title {
      font-size: 1.375rem;
    }
  }
</style>

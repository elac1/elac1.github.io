---
import IndexLayout from '@/layouts/IndexLayout.astro'
import { themeConfig } from '@/config'
---

<IndexLayout title={`搜索 - ${themeConfig.site.title}`} description="搜索本站文章">
  <header class="page-header stack">
    <h1 class="page-title">搜索</h1>
    <p class="page-desc">输入关键词搜索全站文章</p>
  </header>

  <section class="panel search-panel">
    <div id="search"></div>
  </section>
</IndexLayout>

<style>
  .search-panel {
    padding-bottom: 1.25rem;
  }
</style>

<style is:global>
  /* Pagefind UI 主题适配 */
  :root {
    --pagefind-ui-primary: var(--text-primary);
    --pagefind-ui-text: var(--text-primary);
    --pagefind-ui-background: var(--sheet);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--code-bg);
    --pagefind-ui-border-radius: 0.5rem;
    --pagefind-ui-font-family: var(--sans);
    --pagefind-ui-font-size: var(--font-size-m);
  }

  .pagefind-ui__search-input {
    padding: 0.75rem 1rem !important;
    border: 1px solid var(--border) !important;
    background: var(--bg) !important;
    color: var(--text-primary) !important;
    border-radius: 0.5rem !important;
    width: 100% !important;
  }
  .pagefind-ui__search-input:focus {
    outline: none !important;
    border-color: var(--text-secondary) !important;
  }
  .pagefind-ui__result {
    padding: 1rem 0 !important;
    border-top: 1px solid var(--border) !important;
  }
  .pagefind-ui__result-title {
    font-weight: var(--font-weight-bold) !important;
    color: var(--text-primary) !important;
  }
  .pagefind-ui__result-title a {
    color: var(--text-primary) !important;
    text-decoration: none !important;
  }
  .pagefind-ui__result-title a:hover {
    text-decoration: underline !important;
  }
  .pagefind-ui__result-excerpt {
    color: var(--text-secondary) !important;
    font-size: var(--font-size-s) !important;
  }
</style>

<script>
  type SearchUI = { destroy(): void }
  type SearchWindow = Window & {
    PagefindUI?: new (options: { element: string; showSubResults: boolean; showImages: boolean }) => SearchUI
  }
  let searchUI: SearchUI | undefined

  async function initSearch() {
    const container = document.getElementById('search')
    if (!container || container.dataset.searchBound) return
    container.dataset.searchBound = 'true'
    try {
      if (!document.querySelector('link[href="/pagefind/pagefind-ui.css"]')) {
        const cssLink = document.createElement('link')
        cssLink.rel = 'stylesheet'
        cssLink.href = '/pagefind/pagefind-ui.css'
        document.head.appendChild(cssLink)
      }
      // Pagefind 的构建产物通过 window 提供 UI 构造器。
      const pagefindPath = '/pagefind/pagefind-ui.js'
      await import(/* @vite-ignore */ pagefindPath)
      if (!container.isConnected) return
      const PagefindUI = (window as SearchWindow).PagefindUI
      if (!PagefindUI) throw new Error('Search UI unavailable')
      searchUI = new PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: false
      })
    } catch {
      if (container.isConnected) container.textContent = '搜索暂时不可用，请稍后重试。'
    }
  }

  document.addEventListener('astro:page-load', initSearch)
  document.addEventListener('astro:before-swap', () => {
    searchUI?.destroy()
    searchUI = undefined
  })
</script>

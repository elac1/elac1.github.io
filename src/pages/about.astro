---
import IndexLayout from '@/layouts/IndexLayout.astro'
import { getEntry, render } from 'astro:content'
import { themeConfig } from '@/config'

const aboutEntry = await getEntry('about', 'about')
const hasContent = aboutEntry?.body ? aboutEntry.body.replace(/<!--[\s\S]*?-->/g, '').trim().length > 0 : false
const { Content } = hasContent && aboutEntry ? await render(aboutEntry) : { Content: null }
---

<IndexLayout title={`关于 - ${themeConfig.site.title}`} description={themeConfig.site.description}>
  <div class="about-page">
    <header class="page-header">
      <h1 class="page-title">关于</h1>
    </header>
    <div class="about-content prose">
      {hasContent && Content ? <Content /> : <p>关于内容尚未填写，可在 src/content/about/about.md 编辑。</p>}
    </div>

    <section class="about-meta">
      <h2>站点信息</h2>
      <dl>
        <dt>作者</dt>
        <dd>{themeConfig.site.author}</dd>
        <dt>站点</dt>
        <dd><a href={themeConfig.site.website}>{themeConfig.site.website}</a></dd>
        <dt>描述</dt>
        <dd>{themeConfig.site.description}</dd>
      </dl>
    </section>
  </div>
</IndexLayout>

<style is:global>
  body:has(.about-page) {
    max-width: none !important;
    padding: 1.5rem !important;
    background: #f6f6f4;
  }
  html.dark body:has(.about-page) {
    background: #1a1a1a;
  }
</style>

<style>
  .about-page {
    max-width: 62rem;
    margin: 0 auto;
    padding: 0.5rem 0 3rem;
  }
  .page-header {
    padding: 2rem 0 1.8rem;
  }
  .page-title {
    margin: 0;
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }
  .about-content {
    margin-bottom: 3rem;
  }
  .about-meta h2 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-secondary);
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }
  .about-meta dl {
    margin: 0;
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.5rem 1.5rem;
  }
  .about-meta dt {
    color: var(--text-secondary);
    font-size: var(--font-size-s);
    font-weight: var(--font-weight-regular);
  }
  .about-meta dd {
    margin: 0;
    color: var(--text-primary);
  }
  .about-meta a {
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 2px;
  }
  .about-meta a:hover {
    text-decoration-color: var(--text-secondary);
  }
  @media (max-width: 640px) {
    .page-title { font-size: 1.55rem; }
  }
  @media (max-width: 600px) {
    .about-meta dl {
      grid-template-columns: 1fr;
      gap: 0.25rem 0;
    }
    .about-meta dt {
      margin-top: 0.75rem;
    }
  }
</style>

---
import IndexLayout from '@/layouts/IndexLayout.astro'
import { getEntry, render } from 'astro:content'
import { themeConfig } from '@/config'

const aboutEntry = await getEntry('about', 'about')
const hasContent = aboutEntry?.body ? aboutEntry.body.replace(/<!--[\s\S]*?-->/g, '').trim().length > 0 : false
const { Content } = hasContent && aboutEntry ? await render(aboutEntry) : { Content: null }
---

<IndexLayout title={`关于 - ${themeConfig.site.title}`} description={themeConfig.site.description}>
  <div class="about-page">
    <header class="page-header">
      <h1 class="page-title">关于</h1>
    </header>
    <div class="about-content prose">
      {hasContent && Content ? <Content /> : <p>关于内容尚未填写，可在 src/content/about/about.md 编辑。</p>}
    </div>

    <section class="about-meta">
      <h2>站点信息</h2>
      <dl>
        <dt>作者</dt>
        <dd>{themeConfig.site.author}</dd>
        <dt>站点</dt>
        <dd><a href={themeConfig.site.website}>{themeConfig.site.website}</a></dd>
        <dt>GitHub</dt>
        <dd><a href="https://github.com/elac1" rel="me noopener" target="_blank">github.com/elac1</a></dd>
        <dt>描述</dt>
        <dd>{themeConfig.site.description}</dd>
      </dl>
    </section>
  </div>
</IndexLayout>

<style is:global>
  body:has(.about-page) {
    max-width: none !important;
    padding: 1.5rem !important;
  }
</style>

<style>
  .about-page {
    max-width: 42rem;
    margin: 0 auto;
    padding: 3.5rem 0 4rem;
  }
  .page-header {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
  }
  .page-title {
    margin: 0;
    font-size: 1.625rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  .about-content {
    margin-bottom: 3.5rem;
  }
  .about-meta h2 {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin: 0 0 1rem;
  }
  .about-meta dl {
    margin: 0;
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.6rem 2rem;
  }
  .about-meta dt {
    color: var(--text-tertiary);
    font-size: 0.875rem;
    font-weight: 400;
  }
  .about-meta dd {
    margin: 0;
    color: var(--text-primary);
    font-size: 0.9375rem;
  }
  .about-meta a {
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
  }
  .about-meta a:hover {
    text-decoration-color: var(--text-secondary);
  }
  @media (max-width: 640px) {
    .about-page {
      padding: 2rem 0 3rem;
    }
    .page-title {
      font-size: 1.375rem;
    }
  }
  @media (max-width: 600px) {
    .about-meta dl {
      grid-template-columns: 1fr;
      gap: 0.25rem 0;
    }
    .about-meta dt {
      margin-top: 0.75rem;
    }
  }
</style>

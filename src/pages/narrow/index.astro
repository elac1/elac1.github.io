---
import IndexLayout from '@/layouts/IndexLayout.astro'
import PostCard from '@/components/widgets/PostCard.astro'
import { themeConfig } from '@/config'
import { getSortedFilteredPosts } from '@/utils/draft'

const allPosts = await getSortedFilteredPosts()
const posts = allPosts.filter((p) => p.data.category === '垂直领域研究')
---

<IndexLayout title={`ROS 机器人 - ${themeConfig.site.title}`} description="ROS 机器人专栏：ROS 2、建图导航、部署调参方向的实战研究">
  <div class="category-page">
    <header class="page-header">
      <h1 class="page-title">ROS 机器人</h1>
      <p class="page-desc">这个栏目只放机器人 / ROS 2 相关内容——从建图导航到部署调参，记录从零搭建到跑通的完整过程，包括参数选择、踩坑总结和效果分析。如果你也在搞机器人，希望这些经验能帮你少走弯路。</p>
    </header>
    {
      posts.length > 0 ? (
        <div class="cards-grid">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      ) : (
        <p class="empty-hint">ROS 机器人栏目暂无内容。</p>
      )
    }
  </div>
</IndexLayout>

<style is:global>
  body:has(.category-page) {
    max-width: none !important;
    padding: 1.5rem !important;
    background: #f6f6f4;
  }
  html.dark body:has(.category-page) {
    background: #1a1a1a;
  }
</style>

<style>
  .category-page {
    max-width: 62rem;
    margin: 0 auto;
    padding: 0.5rem 0 3rem;
  }
  .page-header {
    padding: 2rem 0 1.8rem;
  }
  .page-title {
    margin: 0;
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }
  .page-desc {
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem;
  }
  .empty-hint {
    text-align: center;
    color: var(--text-secondary);
    padding: 2rem 0;
  }
  @media (max-width: 640px) {
    .page-title { font-size: 1.55rem; }
    .cards-grid { grid-template-columns: 1fr; }
  }
</style>

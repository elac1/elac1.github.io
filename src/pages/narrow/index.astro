---
import IndexLayout from '@/layouts/IndexLayout.astro'
import PostList from '@/components/widgets/PostList.astro'
import { themeConfig } from '@/config'
import { getSortedFilteredPosts } from '@/utils/draft'

const allPosts = await getSortedFilteredPosts()
const posts = allPosts.filter((p) => p.data.category === '垂直领域研究')
---

<IndexLayout title={`ROS 机器人 - ${themeConfig.site.title}`} description="ROS 机器人专栏：ROS 2、建图导航、部署调参方向的实战研究">
  <main>
    <header class="section-header">
      <h1 class="page-title">ROS 机器人</h1>
      <p class="page-desc">这个栏目只放机器人 / ROS 2 相关内容——从建图导航到部署调参，记录从零搭建到跑通的完整过程，包括参数选择、踩坑总结和效果分析。如果你也在搞机器人，希望这些经验能帮你少走弯路。</p>
    </header>
    {posts.length > 0 ? (
      <PostList posts={posts} />
    ) : (
      <p class="empty-hint">ROS 机器人栏目暂无内容。</p>
    )}
  </main>
</IndexLayout>

<style>
  .section-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .page-title {
    font-size: var(--font-size-l);
    font-weight: var(--font-weight-bold);
    margin: 0 0 0.4rem;
  }
  .page-desc {
    color: var(--text-secondary);
    font-size: var(--font-size-s);
    margin: 0;
    line-height: 1.7;
  }
  .empty-hint {
    text-align: center;
    color: var(--text-secondary);
    padding: 2rem 0;
  }
</style>

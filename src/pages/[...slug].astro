---
import { type CollectionEntry, getCollection } from 'astro:content'
import PostLayout from '@/layouts/PostLayout.astro'
import PostFooter from '@/components/widgets/PostFooter.astro'
import { render } from 'astro:content'
import { getPostSlug, isDraftPost } from '@/utils/post'

export async function getStaticPaths() {
  const posts = await getCollection('posts')
  return posts
    .filter((post) => !isDraftPost(post))
    .map((post) => ({
      params: { slug: getPostSlug(post) },
      props: post
    }))
}

type Props = CollectionEntry<'posts'>

const post = Astro.props
const { Content, remarkPluginFrontmatter } = await render(post)

const readingTime = remarkPluginFrontmatter.readingTime
const toc = remarkPluginFrontmatter.toc || []
const contentFeatures = remarkPluginFrontmatter.contentFeatures || {}
---

<PostLayout {...post.data} readingTime={readingTime} toc={toc} contentFeatures={contentFeatures}>
  <Content />
  {
    post.data.kind === 'project' ? (
      <div class="project-detail-footer" slot="postFooter">
        <a href="/projects/">查看全部项目 ↗</a>
      </div>
    ) : (
      <PostFooter post={post} slot="postFooter" />
    )
  }
</PostLayout>

<style>
  .project-detail-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .project-detail-footer a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.875rem;
  }
  .project-detail-footer a:hover {
    color: var(--text-primary);
  }
</style>

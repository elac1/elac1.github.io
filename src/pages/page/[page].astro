---
import type { GetStaticPaths } from 'astro'
import type { CollectionEntry } from 'astro:content'
import IndexLayout from '@/layouts/IndexLayout.astro'
import PostMonthList from '@/components/widgets/PostMonthList.astro'
import Pagination from '@/components/widgets/Pagination.astro'
import { themeConfig } from '@/config'
import { getPostStream, POST_PAGE_SIZE } from '@/utils/draft'

export const getStaticPaths = (async ({ paginate }) => {
  const stream = await getPostStream()
  return paginate(stream, { pageSize: POST_PAGE_SIZE }).filter(
    (result) => result.params.page !== '1'
  )
}) satisfies GetStaticPaths

const { page } = Astro.props
const posts = page.data as CollectionEntry<'posts'>[]
---

<IndexLayout
  title={`第 ${page.currentPage} 页 - ${themeConfig.site.title}`}
  description={themeConfig.site.description}
>
  <div class="paged-home">
    <header class="page-head">
      <h1 class="page-title">文章</h1>
      <span class="page-indicator">第 {page.currentPage} / {page.lastPage} 页</span>
    </header>

    <PostMonthList posts={posts} />

    <Pagination current={page.currentPage} total={page.lastPage} />
  </div>
</IndexLayout>

<style is:global>
  body:has(.paged-home) {
    max-width: none !important;
    padding: 1.5rem !important;
  }
</style>

<style>
  .paged-home {
    max-width: 44rem;
    margin: 0 auto;
    padding: 3.5rem 0 4rem;
  }
  .page-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.25rem;
  }
  .page-title {
    margin: 0;
    font-size: 1.625rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }
  .page-indicator {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 640px) {
    .paged-home {
      padding: 2rem 0 3rem;
    }
    .page-title {
      font-size: 1.375rem;
    }
  }
</style>

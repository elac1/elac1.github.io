---
import IndexLayout from '@/layouts/IndexLayout.astro'
import PostCard from '@/components/widgets/PostCard.astro'
import { getSortedFilteredPosts } from '@/utils/draft'
import { themeConfig } from '@/config'

const posts = await getSortedFilteredPosts()

// 按年份分组（保持时间线浏览的核心价值）
const postsByYear = new Map<number, typeof posts>()
for (const post of posts) {
  const year = post.data.pubDate.getFullYear()
  if (!postsByYear.has(year)) postsByYear.set(year, [])
  postsByYear.get(year)!.push(post)
}
const years = [...postsByYear.keys()].sort((a, b) => b - a)
---

<IndexLayout title={`归档 - ${themeConfig.site.title}`} description="所有文章按时间归档">
  <div class="archive-page">
    <header class="archive-header">
      <h1 class="page-title">归档</h1>
      <p class="page-count">共 {posts.length} 篇文章</p>
    </header>
    {
      years.map((year) => (
        <section class="archive-year">
          <h2 class="year-title">{year}</h2>
          <div class="archive-grid">
            {postsByYear.get(year)!.map((post) => <PostCard post={post} />)}
          </div>
        </section>
      ))
    }
  </div>
</IndexLayout>

<style is:global>
  /* 归档页使用宽屏布局，与首页保持一致 */
  body:has(.archive-page) {
    max-width: none !important;
    padding: 1.5rem !important;
    background: #f6f6f4;
  }
  html.dark body:has(.archive-page) {
    background: #1a1a1a;
  }
</style>

<style>
  .archive-page {
    max-width: 62rem;
    margin: 0 auto;
    padding: 1rem 0 3rem;
  }
  .archive-header {
    margin-bottom: 0.5rem;
  }
  .page-title {
    font-size: var(--font-size-l);
    font-weight: var(--font-weight-bold);
    margin: 0 0 0.25rem;
  }
  .page-count {
    color: var(--text-secondary);
    font-size: var(--font-size-s);
    margin: 0 0 2rem;
  }
  .archive-year {
    margin-bottom: 2.5rem;
  }
  .year-title {
    font-size: var(--font-size-m);
    font-weight: var(--font-weight-bold);
    color: var(--text-secondary);
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }
  /* 年内复用首页卡片网格：封面/圆角/阴影/降级逻辑只此一份 */
  .archive-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.1rem;
  }
  @media (max-width: 640px) {
    .archive-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

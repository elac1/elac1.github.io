---
import IndexLayout from '@/layouts/IndexLayout.astro'
import PostCard from '@/components/widgets/PostCard.astro'
import { getSortedFilteredPosts } from '@/utils/draft'
import { themeConfig } from '@/config'

const posts = await getSortedFilteredPosts()

const postsByYear = new Map<number, typeof posts>()
for (const post of posts) {
  const year = post.data.pubDate.getFullYear()
  if (!postsByYear.has(year)) postsByYear.set(year, [])
  postsByYear.get(year)!.push(post)
}
const years = [...postsByYear.keys()].sort((a, b) => b - a)
---

<IndexLayout title={`归档 - ${themeConfig.site.title}`} description="所有文章按时间归档">
  <div class="archive-page">
    <header class="archive-header">
      <h1 class="page-title">归档</h1>
      <p class="page-count">共 {posts.length} 篇</p>
    </header>
    {
      years.map((year) => (
        <section class="archive-year">
          <h2 class="year-title">{year}</h2>
          <div class="year-list">
            {postsByYear.get(year)!.map((post) => <PostCard post={post} />)}
          </div>
        </section>
      ))
    }
  </div>
</IndexLayout>

<style is:global>
  body:has(.archive-page) {
    max-width: none !important;
    padding: 1.5rem !important;
  }
</style>

<style>
  .archive-page {
    max-width: 44rem;
    margin: 0 auto;
    padding: 3.5rem 0 4rem;
  }
  .archive-header {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1rem;
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
  }
  .page-title {
    margin: 0;
    font-size: 1.625rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }
  .page-count {
    margin: 0;
    color: var(--text-tertiary);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .archive-year + .archive-year {
    margin-top: 2.5rem;
  }
  .year-title {
    margin: 0 0 0.25rem;
    padding: 0 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }
  .year-list {
    display: flex;
    flex-direction: column;
  }
  @media (max-width: 640px) {
    .archive-page {
      padding: 2rem 0 3rem;
    }
    .page-title {
      font-size: 1.375rem;
    }
  }
</style>

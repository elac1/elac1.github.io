---
import IndexLayout from '@/layouts/IndexLayout.astro'
import { friendLinks } from '@/data/links'
import { themeConfig } from '@/config'
---

<IndexLayout title={`友链 - ${themeConfig.site.title}`} description="友情链接">
  <header class="page-header stack">
    <h1 class="page-title">友链</h1>
    <p class="page-desc">这里收集我常逛的博客和站点。想交换友链可在 about.md 留的联系方式找我。</p>
  </header>

  {
    friendLinks.length === 0 ? (
      <p class="page-empty">还没有友链。在 src/data/links.ts 的 friendLinks 数组里添加即可。</p>
    ) : (
      <ul class="links-list">
        {friendLinks.map((link) => (
          <li>
            <a href={link.url} target="_blank" rel="noopener noreferrer" class="link-card">
              {link.avatar ? (
                <img src={link.avatar} alt={link.name} class="link-avatar" loading="lazy" />
              ) : (
                <div class="link-avatar placeholder">{link.name.charAt(0)}</div>
              )}
              <div class="link-meta">
                <span class="link-name">{link.name}</span>
                {link.desc && <span class="link-desc">{link.desc}</span>}
                <span class="link-url">{new URL(link.url).host}</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</IndexLayout>

<style>
  .links-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 1rem;
  }
  .link-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    background: var(--sheet);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    color: var(--text-primary);
    text-decoration: none;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
    transition:
      border-color 0.15s ease-out,
      transform 0.15s ease-out,
      box-shadow 0.15s ease-out;
  }
  .link-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.05);
  }
  html.dark .link-card:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }
  .link-avatar {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    flex-shrink: 0;
    object-fit: cover;
  }
  .link-avatar.placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--tag-bg);
    color: var(--tag-text);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-m);
  }
  .link-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .link-name {
    font-weight: var(--font-weight-bold);
  }
  .link-desc {
    color: var(--text-secondary);
    font-size: var(--font-size-s);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .link-url {
    color: var(--text-tertiary);
    font-size: 0.75rem;
  }
</style>

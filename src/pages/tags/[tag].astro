---
import IndexLayout from '@/layouts/IndexLayout.astro'
import PostCard from '@/components/widgets/PostCard.astro'
import { getSortedFilteredPosts } from '@/utils/draft'
import { themeConfig } from '@/config'

export async function getStaticPaths() {
  const posts = await getSortedFilteredPosts()
  const tagSet = new Set<string>()
  for (const post of posts) {
    for (const tag of post.data.tags || []) {
      tagSet.add(tag)
    }
  }
  return [...tagSet].map((tag) => ({
    params: { tag },
    props: { tag }
  }))
}

const { tag } = Astro.props
const allPosts = await getSortedFilteredPosts()
const filteredPosts = allPosts.filter((p) => (p.data.tags || []).includes(tag))
---

<IndexLayout title={`#${tag} - ${themeConfig.site.title}`} description={`标签 ${tag} 下的文章`}>
  <header class="page-header">
    <h1 class="page-title">#{tag}</h1>
    <p class="page-count">共 {filteredPosts.length} 篇</p>
    <a class="back-link" href="/tags/">← 所有标签</a>
  </header>
  {
    filteredPosts.length > 0 ? (
      <section class="panel">
        <div class="panel-list">
          {filteredPosts.map((post) => (
            <PostCard post={post} variant="list" thumb />
          ))}
        </div>
      </section>
    ) : (
      <p class="page-empty">这个标签下还没有文章。</p>
    )
  }
</IndexLayout>

<style>
  .back-link {
    margin-left: auto;
    color: var(--text-tertiary);
    font-size: 0.8125rem;
    text-decoration: none;
    transition: color 0.15s ease-out;
  }
  .back-link:hover {
    color: var(--text-primary);
  }
</style>

---
import IndexLayout from '@/layouts/IndexLayout.astro'
import { getSortedFilteredPosts } from '@/utils/draft'
import { themeConfig } from '@/config'

const posts = await getSortedFilteredPosts()

// 统计每个标签的文章数
const tagCount = new Map<string, number>()
for (const post of posts) {
  for (const tag of post.data.tags || []) {
    tagCount.set(tag, (tagCount.get(tag) || 0) + 1)
  }
}

// 按文章数降序排序
const tags = [...tagCount.entries()].sort((a, b) => b[1] - a[1])

// 计算最大文章数，用于标签云字号
const maxCount = Math.max(1, ...tags.map((t) => t[1]))
---

<IndexLayout title={`标签 - ${themeConfig.site.title}`} description="按标签浏览文章">
  <main>
    <h1 class="page-title">标签</h1>
    <p class="page-count">共 {tags.length} 个标签</p>
    {
      tags.length === 0 ? (
        <p class="empty">还没有标签，写文章时在 frontmatter 加 <code>tags:</code> 字段即可生成标签。</p>
      ) : (
        <ul class="tag-cloud">
          {tags.map(([tag, count]) => {
            const size = 0.85 + (count / maxCount) * 0.6
            return (
              <li>
                <a href={`/tags/${encodeURIComponent(tag)}/`} style={`font-size: ${size}rem`}>
                  <span class="tag-name">{tag}</span>
                  <span class="tag-count">{count}</span>
                </a>
              </li>
            )
          })}
        </ul>
      )
    }
  </main>
</IndexLayout>

<style>
  .page-title {
    font-size: var(--font-size-l);
    font-weight: var(--font-weight-bold);
    margin: 0 0 0.25rem;
  }
  .page-count {
    color: var(--text-secondary);
    font-size: var(--font-size-s);
    margin: 0 0 2rem;
  }
  .empty {
    color: var(--text-secondary);
    font-size: var(--font-size-s);
  }
  .empty code {
    background: var(--code-bg);
    padding: 0.1rem 0.3rem;
    border-radius: 0.25rem;
    font-size: 0.85em;
  }
  .tag-cloud {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .tag-cloud a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    color: var(--text-primary);
    text-decoration: none;
    transition: all 0.15s ease-out;
  }
  .tag-cloud a:hover {
    border-color: var(--text-secondary);
    background: var(--code-bg);
  }
  .tag-count {
    color: var(--text-secondary);
    font-size: 0.75em;
  }
</style>

---
import { themeConfig } from '@/config'
import { navItems } from '@/data/nav'
import ThemeToggle from '@/components/ui/ThemeToggle.astro'

// 当前页面高亮
const path = Astro.url.pathname
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href))
---

<header class="tab-nav">
  <nav class="tab-list" aria-label="主导航">
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class:list={['tab-link', { active: isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>

  <div class="tab-actions">
    {
      themeConfig.site.github && (
        <a href={themeConfig.site.github} aria-label="GitHub" title="GitHub" class="action-icon" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.15c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.24 3.33.95.1-.74.4-1.24.72-1.53-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 2.87-.39c.97 0 1.96.13 2.87.39 2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.73.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.41-5.25 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
          </svg>
        </a>
      )
    }
    <a href="/search" aria-label="搜索" title="搜索" class="action-icon">
      <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-3.5-3.5" />
      </svg>
    </a>
    <a href="/rss.xml" aria-label="RSS 订阅" title="RSS" class="action-icon">
      <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 11a9 9 0 0 1 9 9" />
        <path d="M4 4a16 16 0 0 1 16 16" />
        <circle cx="5" cy="19" r="1.4" fill="currentColor" stroke="none" />
      </svg>
    </a>
    {themeConfig.general.themeToggle && <ThemeToggle />}
  </div>
</header>

<style>
  .tab-nav {
    position: sticky;
    top: 0.75rem;
    z-index: 120;
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    width: 100%;
    max-width: var(--layout-max);
    margin: 0 auto 2.5rem;
    box-sizing: border-box;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--header-bg);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.04);
    overflow: hidden;
  }
  .tab-list {
    display: flex;
    align-items: stretch;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tab-list::-webkit-scrollbar {
    display: none;
  }
  .tab-link {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.4rem;
    border-right: 1px solid var(--border);
    font-size: 0.875rem;
    color: var(--text-secondary);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.15s ease-out,
      background-color 0.15s ease-out;
  }
  .tab-link:hover {
    color: var(--text-primary);
    background: var(--surface-muted);
  }
  .tab-link.active {
    color: var(--text-primary);
    font-weight: 600;
    background: var(--surface-muted);
  }
  .tab-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0 1rem;
    border-left: 1px solid var(--border);
    flex-shrink: 0;
  }
  .action-icon {
    color: var(--text-tertiary);
    display: inline-flex;
    transition: color 0.15s ease-out;
  }
  .action-icon:hover {
    color: var(--text-primary);
  }
  .tab-actions :global(.theme-toggle) {
    width: 1.2rem;
    height: 1.2rem;
  }

  @media (max-width: 640px) {
    .tab-link {
      padding: 0.65rem 0.78rem;
      font-size: 0.8125rem;
    }
    .tab-actions {
      padding: 0 0.65rem;
      gap: 0.55rem;
    }
    .tab-actions a[title='GitHub'],
    .tab-actions a[title='RSS'] {
      display: none;
    }
  }
</style>

---
import { themeConfig } from '@/config'
const today = new Date()

const quickLinks = [
  { href: '/', label: '首页' },
  { href: '/archive', label: '文章' },
  { href: '/notes', label: '笔记' },
  { href: '/narrow', label: '技术' },
  { href: '/about', label: '关于' }
]
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-col brand-col">
      <div class="footer-brand">{themeConfig.site.title}</div>
      <p class="footer-tagline">{themeConfig.site.tagline ?? themeConfig.site.description}</p>
    </div>

    <div class="footer-col">
      <h4 class="footer-heading">快速导航</h4>
      <ul class="footer-links">
        {quickLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>

    {
      themeConfig.techStack && themeConfig.techStack.length > 0 && (
        <div class="footer-col">
          <h4 class="footer-heading">技术栈</h4>
          <ul class="footer-tags">
            {themeConfig.techStack.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </div>
      )
    }

    {
      themeConfig.friendLinks && themeConfig.friendLinks.length > 0 && (
        <div class="footer-col">
          <h4 class="footer-heading">友情链接</h4>
          <ul class="footer-links">
            {themeConfig.friendLinks.map((link) => (
              <li><a href={link.href} target="_blank" rel="noopener noreferrer">{link.name}</a></li>
            ))}
          </ul>
        </div>
      )
    }
  </div>

  <div class="footer-bottom">
    <span>&copy; {today.getFullYear()} {themeConfig.site.author}. All rights reserved.</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    padding: 3rem 0 2rem;
    border-top: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 0.8125rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: 2.5rem;
  }

  .brand-col .footer-brand {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }
  .brand-col .footer-tagline {
    margin: 0.5rem 0 0;
    color: var(--text-tertiary);
    line-height: 1.7;
    max-width: 20rem;
  }

  .footer-heading {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .footer-links,
  .footer-tags {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer-links li,
  .footer-tags li {
    margin-bottom: 0.35rem;
  }
  .footer-links a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease-out;
  }
  .footer-links a:hover {
    color: var(--text-primary);
  }
  .footer-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .footer-tags li {
    background: var(--surface-muted);
    color: var(--text-secondary);
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    font-size: 0.72rem;
    margin-bottom: 0;
  }

  .footer-bottom {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: 0.75rem;
    color: var(--text-tertiary);
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .brand-col {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 480px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>

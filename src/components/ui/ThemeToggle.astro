<button id="theme-toggle" class="theme-toggle" aria-label="切换主题">
  <!-- 浅色模式下显示月亮（点击切到暗黑） -->
  <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
  </svg>
  <!-- 暗黑模式下显示太阳（点击切到浅色） -->
  <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4.5" />
    <path d="M12 1.5v2.5M12 20v2.5M4.22 4.22l1.77 1.77M18.01 18.01l1.77 1.77M1.5 12H4M20 12h2.5M4.22 19.78l1.77-1.77M18.01 5.99l1.77-1.77" />
  </svg>
</button>

<script is:inline>
  function bindThemeToggle() {
    const themeToggle = document.getElementById('theme-toggle')
    if (!themeToggle || !window.ThemeManager) return

    // 已绑定则跳过，避免重复监听
    if (themeToggle.dataset.themeBound) return
    themeToggle.dataset.themeBound = 'true'

    // 根据当前主题更新无障碍标签
    function updateLabel() {
      const isDark = document.documentElement.classList.contains('dark')
      const label = isDark ? '切换到浅色模式' : '切换到暗黑模式'
      themeToggle.setAttribute('aria-label', label)
      themeToggle.title = label
    }

    themeToggle.addEventListener('click', function (e) {
      e.preventDefault()
      e.stopPropagation()
      window.ThemeManager.toggle()
    })

    document.addEventListener('themechange', updateLabel)
    updateLabel()
  }

  // astro:page-load 在首屏和客户端导航后都会触发
  document.addEventListener('astro:page-load', bindThemeToggle)
</script>

<style>
  .theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--text-primary);
    opacity: 0.55;
    transition: opacity 0.2s ease-out;
    padding: 0;
  }

  .theme-toggle:hover {
    opacity: 1;
  }

  /* 图标随主题切换：浅色显月亮、暗黑显太阳 */
  .theme-toggle .icon-sun {
    display: none;
  }
  html.dark .theme-toggle .icon-moon {
    display: none;
  }
  html.dark .theme-toggle .icon-sun {
    display: block;
  }

  @media (hover: none) and (pointer: coarse) {
    .theme-toggle:hover {
      opacity: 0.55;
    }
  }
</style>

---
import { themeConfig } from '@/config'
import type { TOCProps } from '@/types'

const { toc = [] }: TOCProps = Astro.props

// 预计算每项是否有子级、最小层级、缩进
const minLevel = toc.reduce((m, t) => Math.min(m, t.level), 6)
const items = toc.map((item, i) => ({
  ...item,
  hasChildren: i < toc.length - 1 && toc[i + 1].level > item.level,
  indent: (item.level - minLevel) * 1.5 // 1.5rem/级，比之前 1.05 更有层次
}))
---

<div class="toc-container" id="toc">
  <div class="toc-title">目录</div>
  <nav class="toc-nav">
    <ul class="toc-list" id="toc-list">
      {
        items.map((item) => (
          <li
            class={`toc-item${item.hasChildren ? ' has-children collapsed' : ''}`}
            data-level={item.level}
            data-has-children={String(item.hasChildren)}
            style={`--indent: ${item.indent}rem; --level: ${item.level}`}
          >
            {item.hasChildren ? (
              <button class="toc-toggle" type="button" aria-label="折叠/展开">
                <span class="toc-arrow">▾</span>
              </button>
            ) : (
              <span class="toc-dot" aria-hidden="true">·</span>
            )}
            <a href={`#${item.id}`} class="toc-link" title={item.text} data-id={item.id}>
              {item.text}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<script
  is:inline
  define:vars={{
    contentWidth: themeConfig.general.contentWidth,
    centeredLayout: themeConfig.general.centeredLayout,
    toc: themeConfig.post.toc
  }}
>
  ;(function () {
    if (window.__tocController?.destroy) {
      window.__tocController.destroy()
    }

    const activeOffset = 128
    const jumpOffset = 96
    const tocWidth = 14 * 16 // 14rem
    const gap = 4.5 * 16 // 4.5rem — 更靠左

    const state = {
      container: null,
      linkList: [],
      toggleList: [],
      headingList: [],
      headingMap: new Map(),
      scrollFrame: null,
      resizeTimeout: null,
      resetTimeout: null,
      activeLink: null,
      activeId: null,
      hasContent: false
    }

    function initElements() {
      state.container = document.querySelector('.toc-container')
      if (!state.container) return false

      state.linkList = Array.from(document.querySelectorAll('.toc-link'))
      state.toggleList = Array.from(document.querySelectorAll('.toc-toggle'))
      state.headingList = Array.from(document.querySelectorAll('h1, h2, h3')).filter(
        (heading, index, headings) => !(index === 0 && headings[0].tagName === 'H1') && heading.id
      )

      state.headingMap.clear()
      state.linkList.forEach((link) => {
        const href = link.getAttribute('href')
        if (href?.startsWith('#')) {
          state.headingMap.set(href.substring(1), link)
        }
      })

      return true
    }

    function checkContent() {
      if (!state.container) return
      state.hasContent = state.linkList.length > 0
      if (!state.hasContent) {
        state.container.style.display = 'none'
      }
    }

    function adjustPosition() {
      if (!state.container || !centeredLayout || !state.hasContent) {
        if (state.container) state.container.style.display = 'none'
        return
      }

      const pageWidth = window.innerWidth
      const contentWidthValue = Math.max(parseFloat(contentWidth), 25)
      const margin = (pageWidth - contentWidthValue * 16) / 2
      const minSpace = tocWidth + gap

      if (margin >= minSpace) {
        state.container.style.display = 'block'
        state.container.classList.add('fixed-position')
        state.container.style.left = `${margin - minSpace}px`
      } else {
        state.container.style.display = 'none'
        state.container.classList.remove('fixed-position')
        state.container.style.left = ''
      }
    }

    // 初始化时把 collapsed 项的子级隐藏（HTML 里已给父级加了 collapsed 类）
    function applyInitialCollapse() {
      const items = document.querySelectorAll('.toc-item')
      items.forEach((item) => {
        const isCollapsed = item.classList.contains('collapsed')
        if (isCollapsed) {
          const level = parseInt(item.dataset.level, 10)
          let next = item.nextElementSibling
          while (next && parseInt(next.dataset.level, 10) > level) {
            next.classList.add('toc-hidden')
            next = next.nextElementSibling
          }
        }
      })
    }

    function handleToggle(e) {
      const btn = e.target.closest('.toc-toggle')
      if (!btn) return
      e.stopPropagation()
      const item = btn.closest('.toc-item')
      if (!item) return
      const level = parseInt(item.dataset.level, 10)
      item.classList.toggle('collapsed')
      const collapsed = item.classList.contains('collapsed')
      let next = item.nextElementSibling
      while (next && parseInt(next.dataset.level, 10) > level) {
        if (collapsed) next.classList.add('toc-hidden')
        else next.classList.remove('toc-hidden')
        next = next.nextElementSibling
      }
    }

    function handleClick(e) {
      const link = e.target.closest('.toc-link')
      if (!link) return
      e.preventDefault()
      const href = link.getAttribute('href')
      if (href?.startsWith('#')) {
        const target = document.getElementById(href.substring(1))
        if (target) {
          const rect = target.getBoundingClientRect()
          const scrollTop = window.pageYOffset || document.documentElement.scrollTop
          const offset = rect.top + scrollTop - jumpOffset
          window.scrollTo({ top: offset, behavior: 'smooth' })
          history.pushState(null, null, href)
        }
      }
    }

    function setActive(nextActiveId) {
      const nextActiveLink =
        nextActiveId && state.headingMap.has(nextActiveId) ? state.headingMap.get(nextActiveId) : null

      if (state.activeId === nextActiveId && state.activeLink === nextActiveLink) {
        return
      }

      if (state.activeLink) {
        state.activeLink.classList.remove('active')
      }
      if (nextActiveLink) {
        nextActiveLink.classList.add('active')
      }

      state.activeId = nextActiveId
      state.activeLink = nextActiveLink
    }

    function refreshActiveHeading() {
      if (!state.headingList.length) {
        setActive(null)
        return
      }
      if (window.pageYOffset < 16 || state.headingList[0].getBoundingClientRect().top > activeOffset) {
        setActive(null)
        return
      }
      for (let i = state.headingList.length - 1; i >= 0; i--) {
        if (state.headingList[i].getBoundingClientRect().top <= activeOffset) {
          setActive(state.headingList[i].id)
          break
        }
      }
    }

    function scheduleActiveRefresh() {
      if (state.scrollFrame) return
      state.scrollFrame = requestAnimationFrame(() => {
        state.scrollFrame = null
        refreshActiveHeading()
      })
    }

    function init(retryCount = 0) {
      const maxRetries = 5
      if (initElements()) {
        applyInitialCollapse()
        checkContent()
        adjustPosition()
        if (state.container) {
          state.container.addEventListener('click', handleClick)
          state.toggleList.forEach((btn) => btn.addEventListener('click', handleToggle))
        }
        refreshActiveHeading()
      } else if (retryCount < maxRetries) {
        setTimeout(() => init(retryCount + 1), 100)
      }
    }

    function handleResize() {
      if (state.resizeTimeout) cancelAnimationFrame(state.resizeTimeout)
      state.resizeTimeout = requestAnimationFrame(() => {
        adjustPosition()
        refreshActiveHeading()
      })
    }

    function cleanup() {
      if (state.activeLink) state.activeLink.classList.remove('active')
      if (state.container) state.container.removeEventListener('click', handleClick)
      state.toggleList.forEach((btn) => btn.removeEventListener('click', handleToggle))
      if (state.scrollFrame) {
        cancelAnimationFrame(state.scrollFrame)
        state.scrollFrame = null
      }
      if (state.resizeTimeout) {
        cancelAnimationFrame(state.resizeTimeout)
        state.resizeTimeout = null
      }
      if (state.resetTimeout) {
        cancelAnimationFrame(state.resetTimeout)
        state.resetTimeout = null
      }
      Object.assign(state, {
        container: null,
        linkList: [],
        toggleList: [],
        headingList: [],
        headingMap: new Map(),
        scrollFrame: null,
        activeLink: null,
        activeId: null,
        hasContent: false
      })
    }

    function reset() {
      state.resetTimeout = null
      cleanup()
      init()
    }

    function scheduleReset() {
      if (state.resetTimeout) cancelAnimationFrame(state.resetTimeout)
      state.resetTimeout = requestAnimationFrame(reset)
    }

    function destroy() {
      cleanup()
      document.removeEventListener('astro:page-load', scheduleReset)
      document.removeEventListener('astro:after-swap', scheduleReset)
      window.removeEventListener('scroll', scheduleActiveRefresh)
      window.removeEventListener('resize', handleResize)
      if (window.__tocController?.destroy === destroy) {
        window.__tocController = null
      }
    }

    document.addEventListener('astro:page-load', scheduleReset)
    document.addEventListener('astro:after-swap', scheduleReset)
    window.addEventListener('scroll', scheduleActiveRefresh, { passive: true })
    window.addEventListener('resize', handleResize)

    window.__tocController = { destroy }
    init()
  })()
</script>

<style is:inline>
  .toc-container {
    width: 14rem;
    position: relative;
    opacity: 0;
    transition: opacity 0.2s ease-out;
    display: none;
  }

  .toc-container.fixed-position {
    opacity: 1;
    position: fixed;
    top: 12rem;
    margin-top: 0;
    padding-left: 1rem;
    z-index: 10;
    left: auto;
  }

  .toc-title {
    font-family: var(--sans);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--text-tertiary);
    margin-bottom: 0.8rem;
    padding-left: 0.1rem;
  }

  .toc-nav {
    font-family: var(--sans);
  }

  .toc-list,
  .toc-list li,
  .toc-item {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .prose .toc-container .toc-list {
    margin-left: 0 !important;
    padding-left: 0 !important;
  }
  .prose .toc-container .toc-list li {
    margin: 0 !important;
    padding: 0 !important;
  }

  .toc-item::before,
  .toc-item::marker {
    display: none;
  }

  .toc-item {
    display: flex;
    align-items: flex-start;
    gap: 0.3rem;
    padding: 0.18rem 0;
    padding-left: var(--indent, 0);
    position: relative;
  }

  /* 等级感：不同 level 用不同字号/字重 */
  .toc-item[data-level="1"] .toc-link {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-secondary);
  }
  .toc-item[data-level="2"] .toc-link {
    font-size: 0.76rem;
  }
  .toc-item[data-level="3"] .toc-link {
    font-size: 0.72rem;
    color: var(--text-tertiary);
  }

  /* 竖线：在缩进前画一条淡线表示层级 */
  .toc-item {
    /* 用伪元素画层级竖线 */
  }

  .toc-toggle,
  .toc-dot {
    flex-shrink: 0;
    width: 0.9rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-tertiary);
    font-size: 0.7rem;
    line-height: 1.5;
    height: 1.5rem;
  }

  .toc-toggle {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .toc-arrow {
    display: inline-block;
    transition: transform 0.18s ease-out;
    font-size: 0.55rem;
    line-height: 1;
  }

  .toc-item.collapsed .toc-arrow {
    transform: rotate(-90deg);
  }

  .toc-dot {
    color: var(--text-tertiary);
    opacity: 0.45;
  }

  .toc-link {
    display: block;
    flex: 1;
    min-width: 0;
    color: var(--text-tertiary);
    text-decoration: none;
    font-size: 0.76rem;
    line-height: 1.5;
    padding: 0.05rem 0;
    transition: color 0.15s ease-out;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    cursor: pointer;
  }

  .toc-link:hover {
    color: var(--text-primary);
  }

  .toc-link.active {
    color: var(--text-primary);
    font-weight: 600;
  }

  /* 子级项左侧画竖线，强化层级感 */
  .toc-item[data-level="2"]:not(.collapsed)::before,
  .toc-item[data-level="3"]:not(.collapsed)::before {
    content: '';
    position: absolute;
    left: calc(var(--indent) - 0.55rem);
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--surface-border);
    opacity: 0.6;
  }

  .toc-item.toc-hidden {
    display: none !important;
  }

  /* Hide on mobile */
  @media (max-width: 768px) {
    .toc-container {
      display: none !important;
    }
  }
</style>

---
import type { CollectionEntry } from 'astro:content'
import { getPostSlug } from '@/utils/post'
import FormattedDate from '@/components/widgets/FormattedDate.astro'
import Icon from './Icon.astro'

type Props = { post: CollectionEntry<'posts'>; latest: boolean; eager?: boolean }
const { post, latest, eager = false } = Astro.props
const href = `/${getPostSlug(post)}/`
---

<article class="home-card" data-home-post data-published={post.data.pubDate.valueOf()} hidden={!latest}>
  <a class="home-card-link" href={href} aria-labelledby={`post-${getPostSlug(post)}`}>
    <div class="home-card-cover">
      {
        post.data.cover ? (
          <img
            src={post.data.cover}
            alt=""
            loading={eager ? 'eager' : 'lazy'}
            decoding="async"
            width="640"
            height="360"
          />
        ) : (
          <Icon name="book" size={36} />
        )
      }
    </div>
    <div class="home-card-body">
      <h3 id={`post-${getPostSlug(post)}`}>{post.data.title}</h3>
      <FormattedDate date={post.data.pubDate} context="list" />
      <div class="home-card-tags">
        {post.data.tags.slice(0, 2).map((tag) => <span>#{tag}</span>)}
      </div>
    </div>
  </a>
</article>

---
import { themeConfig } from '@/config'
---

<canvas
  class="stellar-sky"
  aria-hidden="true"
  data-starfield
  data-density={themeConfig.general.starDensity ?? 150}
  data-brightness={themeConfig.general.starBrightness ?? 0.75}></canvas>
<script>
  let cleanup = () => {}

  function initStarfield() {
    cleanup()
    const canvas = document.querySelector<HTMLCanvasElement>('[data-starfield]')
    const button = document.querySelector<HTMLButtonElement>('[data-star-toggle]')
    const context = canvas?.getContext('2d')
    if (!canvas || !context || !button) return
    const ctx = context
    const surface = canvas
    const toggle = button
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)')
    let playing = true
    try {
      playing = localStorage.getItem('elac-star-motion') !== 'paused'
    } catch {
      /* Storage may be unavailable. */
    }
    const density = Math.max(30, Math.min(150, Number(surface.dataset.density) || 150))
    const brightness = Math.max(0.25, Math.min(0.85, Number(surface.dataset.brightness) || 0.75))
    let width = 0,
      height = 0,
      frame = 0,
      last = 0,
      phase = 0
    let colors = {
      star: '',
      blue: '',
      violet: '',
      gold: '',
      line: '',
      violetCloud: '',
      blueCloud: '',
      goldCloud: '',
      clear: ''
    }
    const random = (i: number) => {
      const n = Math.sin(i * 71.71 + 47.93) * 43758.5453
      return n - Math.floor(n)
    }
    const stars = Array.from({ length: density }, (_, i) => ({
      x: random(i * 3 + 1),
      y: random(i * 3 + 2),
      radius: 0.45 + random(i * 3 + 3) * 0.7,
      alpha: 0.23 + random(i + 160) * 0.6
    }))

    function readColors() {
      const style = getComputedStyle(document.documentElement)
      const color = (name: string) => style.getPropertyValue(name).trim()
      colors = {
        star: color('--stellar-star'),
        blue: color('--stellar-blue'),
        violet: color('--stellar-violet'),
        gold: color('--stellar-gold'),
        line: color('--stellar-orbit'),
        violetCloud: color('--stellar-cloud-violet'),
        blueCloud: color('--stellar-cloud-blue'),
        goldCloud: color('--stellar-cloud-gold'),
        clear: color('--stellar-cloud-clear')
      }
    }
    function draw() {
      if (!width || !height) return
      const dpr = Math.min(window.devicePixelRatio || 1, 2)
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      ctx.clearRect(0, 0, width, height)
      const clouds = [
        { x: 0.81, y: 150, r: 0.46, color: colors.violetCloud },
        { x: 0.4, y: height * 0.52, r: 0.43, color: colors.blueCloud },
        { x: 0.88, y: height * 0.8, r: 0.31, color: colors.goldCloud }
      ]
      for (const cloud of clouds) {
        const gradient = ctx.createRadialGradient(
          width * cloud.x,
          cloud.y,
          0,
          width * cloud.x,
          cloud.y,
          width * cloud.r
        )
        gradient.addColorStop(0, cloud.color)
        gradient.addColorStop(1, colors.clear)
        ctx.fillStyle = gradient
        ctx.fillRect(0, 0, width, height)
      }
      const reading = document.body.dataset.pageType === 'post'
      stars.forEach((star, i) => {
        const y = (star.y * height + Math.sin(phase + i) * 1.6 + height) % height
        ctx.globalAlpha = brightness * star.alpha * (0.77 + 0.23 * Math.sin(phase * 0.7 + i)) * (reading ? 0.3 : 1)
        ctx.fillStyle =
          i % 17 === 0 ? colors.gold : i % 11 === 0 ? colors.blue : i % 7 === 0 ? colors.violet : colors.star
        ctx.beginPath()
        ctx.arc(star.x * width, y, star.radius, 0, Math.PI * 2)
        ctx.fill()
      })
      ctx.globalAlpha = 1
    }
    function resize() {
      width = window.innerWidth
      height = window.innerHeight
      const dpr = Math.min(window.devicePixelRatio || 1, 2)
      surface.width = Math.round(width * dpr)
      surface.height = Math.round(height * dpr)
      readColors()
      draw()
    }
    function animate(now: number) {
      frame = 0
      if (!playing || reduced.matches || document.hidden) return
      if (last && now - last < 32) {
        frame = requestAnimationFrame(animate)
        return
      }
      if (last) phase += Math.min(now - last, 80) * 0.00022
      last = now
      draw()
      frame = requestAnimationFrame(animate)
    }
    function sync() {
      if (frame) cancelAnimationFrame(frame)
      frame = 0
      last = 0
      const stopped = !playing || reduced.matches
      toggle.setAttribute('aria-pressed', String(stopped))
      toggle.setAttribute('aria-label', stopped ? '开启星空动态' : '暂停星空动态')
      toggle.querySelector('.motion-label')!.textContent = stopped ? '流动星空' : '静止星空'
      toggle.disabled = reduced.matches
      document.documentElement.dataset.starMotion = stopped ? 'paused' : 'playing'
      draw()
      if (!stopped && !document.hidden) frame = requestAnimationFrame(animate)
    }
    function onToggle() {
      playing = !playing
      try {
        localStorage.setItem('elac-star-motion', playing ? 'playing' : 'paused')
      } catch {
        /* No persistence in private mode. */
      }
      sync()
    }
    function onTheme() {
      readColors()
      draw()
    }
    toggle.addEventListener('click', onToggle)
    window.addEventListener('resize', resize)
    document.addEventListener('visibilitychange', sync)
    document.addEventListener('themechange', onTheme)
    reduced.addEventListener('change', sync)
    resize()
    sync()
    cleanup = () => {
      if (frame) cancelAnimationFrame(frame)
      toggle.removeEventListener('click', onToggle)
      window.removeEventListener('resize', resize)
      document.removeEventListener('visibilitychange', sync)
      document.removeEventListener('themechange', onTheme)
      reduced.removeEventListener('change', sync)
    }
  }
  document.addEventListener('astro:before-swap', () => cleanup())
  document.addEventListener('astro:page-load', initStarfield)
</script>

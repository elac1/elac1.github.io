---
import type { Project } from '@/data/projects'
import Icon from './Icon.astro'

type Props = { project: Project }
const { project } = Astro.props
---

<article class="home-card">
  <a class="home-card-link home-project-card" href={project.href}>
    <div class="home-card-cover">
      {
        project.cover ? (
          <img src={project.cover} alt="" loading="lazy" decoding="async" width="640" height="360" />
        ) : (
          <Icon name="blocks" size={36} />
        )
      }
    </div>
    <div class="home-card-body">
      <h3>{project.name}</h3>
      <p class="home-project-summary" title={project.description}>{project.description}</p>
      <div class="home-card-tags">{project.tech.map((tech) => <span>{tech}</span>)}</div>
    </div>
  </a>
</article>

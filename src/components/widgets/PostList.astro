---
import FormattedDate from '@/components/widgets/FormattedDate.astro'
import type { PostListProps } from '@/types'
import type { CollectionEntry } from 'astro:content'

const { posts } = Astro.props as PostListProps

// 提取文章摘要：优先用 frontmatter 的 description，没有则从正文提取纯文本前 80 字
function getExcerpt(post: CollectionEntry<'posts'>): string {
  if (post.data.description) return post.data.description
  const body = post.body ?? ''
  const text = body
    .replace(/```[\s\S]*?```/g, ' ') // 代码块
    .replace(/~~~[\s\S]*?~~~/g, ' ') // 波浪线代码块
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ') // 图片
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1') // 链接保留文字
    .replace(/^#{1,6}\s+/gm, '') // 标题符号
    .replace(/^\s*>+/gm, ' ') // 引用符号
    .replace(/[`*_~|]/g, ' ') // 行内格式符号
    .replace(/\s+/g, ' ')
    .trim()
  if (!text) return ''
  return text.length > 80 ? text.slice(0, 80) + '…' : text
}
---

<ul class="post-grid">
  {
    posts.map((post) => {
      const excerpt = getExcerpt(post)
      return (
        <li class="post-card">
          <a class="card-link" href={`/${post.id}/`} aria-label={post.data.title}></a>
          <h2 class="card-title">{post.data.title}</h2>
          {excerpt && <p class="card-excerpt">{excerpt}</p>}
          <div class="card-meta">
            <div class="card-tags">
              {post.data.tags &&
                post.data.tags.map((t) => (
                  <a href={`/tags/${encodeURIComponent(t)}/`} class="card-tag">
                    {t}
                  </a>
                ))}
            </div>
            <span class="card-date">
              <FormattedDate date={post.data.pubDate} context="list" />
            </span>
          </div>
        </li>
      )
    })
  }
</ul>
<div class="placeholder"></div>

<style>
  .post-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14.5rem, 1fr));
    gap: 1.1rem;
  }

  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 0.875rem;
    padding: 1.15rem 1.25rem 1rem;
    box-shadow: var(--card-shadow);
    transition:
      transform 0.18s ease-out,
      box-shadow 0.18s ease-out,
      border-color 0.18s ease-out;
  }

  @media (hover: hover) and (pointer: fine) {
    .post-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--card-shadow-hover);
      border-color: var(--text-tertiary);
    }
  }

  /* 整卡可点击：覆盖链接铺满卡片，标签链接在上层可单独点 */
  .card-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }

  .card-title {
    margin: 0;
    font-size: var(--font-size-m);
    font-weight: var(--font-weight-bold);
    line-height: 1.45;
    color: var(--text-primary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-excerpt {
    margin: 0.55rem 0 0;
    font-size: var(--font-size-s);
    line-height: 1.65;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-meta {
    margin-top: auto;
    padding-top: 0.9rem;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    min-width: 0;
  }

  .card-tag {
    position: relative;
    z-index: 2;
    font-size: 0.72rem;
    line-height: 1.6;
    padding: 0.05rem 0.55rem;
    border-radius: 999px;
    background: var(--code-bg);
    color: var(--text-secondary);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease-out;
  }

  .card-tag:hover {
    color: var(--text-primary);
  }

  .card-date {
    position: relative;
    z-index: 2;
    margin-left: auto;
    font-size: 0.72rem;
    color: var(--text-tertiary);
    letter-spacing: var(--spacing-s);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  .placeholder {
    height: 3rem;
  }

  @media (max-width: 480px) {
    .post-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
// 基于 Giscus（GitHub Discussions）的文章评论
// 需要在仓库安装 giscus App：https://github.com/apps/giscus
---

<section class="comments-block" id="comments">
  <h2 class="comments-title">评论</h2>
  <div class="giscus"></div>
</section>

<script is:inline>
  ;(function () {
    function reveal(frame) {
      frame.style.removeProperty('opacity')
      frame.classList.remove('giscus-frame--loading')
    }

    // giscus 官方脚本靠 iframe 的 load 事件去掉透明态，懒加载时机下偶尔丢失该回调，
    // 这里用「iframe 已被撑出高度」（即评论界面渲染完成）作为兜底信号强制显示。
    function watchReveal(host) {
      const poll = setInterval(() => {
        const frame = host.querySelector('iframe.giscus-frame')
        if (!frame) return
        clearInterval(poll)
        frame.addEventListener('load', () => reveal(frame), { once: true })
        const fallback = setInterval(() => {
          if (frame.getBoundingClientRect().height > 0) {
            reveal(frame)
            clearInterval(fallback)
          }
        }, 400)
        setTimeout(() => clearInterval(fallback), 20000)
      }, 200)
      setTimeout(() => clearInterval(poll), 20000)
    }

    function mount() {
      const host = document.querySelector('.comments-block .giscus')
      if (!host || host.firstElementChild) return

      const dark = document.documentElement.classList.contains('dark')
      const script = document.createElement('script')
      script.src = 'https://giscus.app/client.js'
      script.async = true
      script.crossOrigin = 'anonymous'
      script.setAttribute('data-repo', 'elac1/elac1.github.io')
      script.setAttribute('data-repo-id', 'R_kgDOVNMQAw')
      script.setAttribute('data-category', 'General')
      script.setAttribute('data-category-id', 'DIC_kwDOVNMQA84DIuF6')
      script.setAttribute('data-mapping', 'pathname')
      script.setAttribute('data-strict', '0')
      script.setAttribute('data-reactions-enabled', '1')
      script.setAttribute('data-emit-metadata', '0')
      script.setAttribute('data-input-position', 'top')
      script.setAttribute('data-theme', dark ? 'dark' : 'light')
      script.setAttribute('data-lang', 'zh-CN')
      script.setAttribute('data-loading', 'lazy')
      host.appendChild(script)
      watchReveal(host)
    }

    function syncTheme() {
      const frame = document.querySelector('.comments-block iframe.giscus-frame')
      if (!frame) return
      const dark = document.documentElement.classList.contains('dark')
      frame.contentWindow?.postMessage(
        { giscus: { setConfig: { theme: dark ? 'dark' : 'light' } } },
        'https://giscus.app'
      )
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', mount, { once: true })
    } else {
      mount()
    }
    document.addEventListener('astro:page-load', mount)
    new MutationObserver(syncTheme).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class']
    })
  })()
</script>

<style>
  .comments-block {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .comments-title {
    margin: 0 0 1.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: 0.01em;
  }
</style>

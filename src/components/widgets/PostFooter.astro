---
import type { CollectionEntry } from 'astro:content'
import { getSortedFilteredPosts } from '@/utils/draft'
import { getPostSlug } from '@/utils/post'
import TagPill from '@/components/widgets/TagPill.astro'
import FormattedDate from '@/components/widgets/FormattedDate.astro'

// 文章页底部：标签 Pill + 基于标签自动推荐的相关文章
type Props = { post: CollectionEntry<'posts'> }
const { post } = Astro.props
const tags = post.data.tags ?? []

// 计算相关文章：共同标签越多越相关；同分时新文章优先；取前 3
const postSlug = getPostSlug(post)
const otherPosts = (await getSortedFilteredPosts()).filter((p) => getPostSlug(p) !== postSlug)
const related = otherPosts
  .map((p) => ({
    post: p,
    score: p.data.tags.filter((t) => tags.includes(t)).length
  }))
  .filter((r) => r.score > 0)
  .sort(
    (a, b) =>
      b.score - a.score ||
      b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf()
  )
  .slice(0, 3)
  .map((r) => r.post)
---

<footer class="post-footer">
  {
    tags.length > 0 && (
      <section class="footer-block">
        <h2 class="footer-heading">标签</h2>
        <div class="footer-pills">
          {tags.map((t) => <TagPill tag={t} />)}
        </div>
      </section>
    )
  }
  {
    related.length > 0 && (
      <section class="footer-block">
        <h2 class="footer-heading">相关文章</h2>
        <ul class="related-list">
          {related.map((r) => (
            <li>
              <a href={`/${getPostSlug(r)}/`} class="related-item">
                <span class="related-title">{r.data.title}</span>
                <span class="related-date">
                  <FormattedDate date={r.data.pubDate} context="list" />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</footer>

<style>
  .post-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .footer-heading {
    margin: 0 0 0.75rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }
  .footer-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  /* 相关文章列表 */
  .related-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .related-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    text-decoration: none;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border);
    transition: opacity 0.15s ease-out;
  }
  .related-item:last-child {
    border-bottom: none;
  }
  .related-item:hover {
    opacity: 0.65;
  }
  .related-title {
    color: var(--text-primary);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .related-date {
    flex-shrink: 0;
    color: var(--text-tertiary);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
  }
</style>

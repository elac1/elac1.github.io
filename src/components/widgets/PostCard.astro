---
import FormattedDate from '@/components/widgets/FormattedDate.astro'
import type { CollectionEntry } from 'astro:content'
import { getPostSlug } from '@/utils/post'

type Props = { post: CollectionEntry<'posts'> }
const { post } = Astro.props

// 摘要：优先 frontmatter description，否则取正文纯文本
function getExcerpt(p: CollectionEntry<'posts'>): string {
  if (p.data.description) return p.data.description
  const text = (p.body ?? '')
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/^#{1,6}\s+/gm, '')
    .replace(/[`*_~|>]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()
  return text.length > 110 ? text.slice(0, 110) + '…' : text
}

const excerpt = getExcerpt(post)
const href = `/${getPostSlug(post)}/`
---

<article class="post-row">
  <div class="row-date">
    <FormattedDate date={post.data.pubDate} context="list" />
  </div>
  <div class="row-main">
    <h3 class="row-title">
      <a href={href}>{post.data.title}</a>
    </h3>
    {excerpt && <p class="row-excerpt">{excerpt}</p>}
  </div>
</article>

<style>
  .post-row {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1.5rem;
    padding: 1.15rem 0.75rem;
    margin: 0 -0.75rem;
    border-radius: 0.5rem;
    transition: background-color 0.15s ease-out;
  }
  .post-row:hover {
    background-color: var(--surface-muted);
  }
  .post-row + .post-row {
    border-top: 1px solid var(--border);
  }

  .row-date {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
    padding-top: 0.2rem;
    white-space: nowrap;
  }

  .row-main {
    min-width: 0;
  }

  .row-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: -0.005em;
  }
  .row-title a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.15s ease-out;
  }
  .post-row:hover .row-title a {
    color: var(--text-primary);
  }

  .row-excerpt {
    margin: 0.35rem 0 0;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .post-row {
      grid-template-columns: 1fr;
      gap: 0.35rem;
      padding: 1rem 0.5rem;
      margin: 0 -0.5rem;
    }
    .row-date {
      font-size: 0.75rem;
      padding-top: 0;
    }
  }
</style>

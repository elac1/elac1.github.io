---
import BaseHead from '@/components/layout/BaseHead.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
type Props = { title: string; description?: string; nav?: boolean }
const { title, description } = Astro.props
---

<BaseLayout title={title} description={description} type="page">
  <BaseHead title={title} description={description} slot="head" />
  <main class="page-content" id="main-content"><slot /></main>
</BaseLayout>
